# ---------------------------------------------------------------- generated data
# Datasets, benchmark results and figures are reproducible artefacts; they are
# NOT caches and are never deleted by scripts/clean_caches.py - remove them by
# hand when you want to regenerate them.
data/
data_*/
runs/
results/
figures/
*.h5
*.hdf5

# ---------------------------------------------------------------------- caches
# Everything below is removed by: python scripts/clean_caches.py
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/
.cache/

# ------------------------------------------------------------ environments / OS
.venv/
venv/
env/
.vscode/
.idea/
.DS_Store
Thumbs.db
